# ==============================================================================
# CONFERENCE NFT TICKET - Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!
# ==============================================================================

# ==============================================================================
# DEPLOYMENT (Server-side only - never expose to client)
# ==============================================================================
# Your wallet mnemonic for deploying contracts (KEEP SECRET!)
MNEMONIC=your twelve word mnemonic phrase goes here never share this

# RPC Provider URL for deployment
PROVIDER_URL=https://polygon-rpc.com

# ==============================================================================
# WALLETCONNECT V2 (Required for mobile wallet connections)
# ==============================================================================
# Get your free project ID at https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ==============================================================================
# POLYGON MAINNET CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_POLYGON_NAME=Polygon
NEXT_PUBLIC_POLYGON_ID=137
NEXT_PUBLIC_POLYGON_CONTRACT_ADDRESS=0xYourContractAddressHere
NEXT_PUBLIC_POLYGON_MARKETPLACE=https://opensea.io/collection/web3-in-travel-nft-ticket
NEXT_PUBLIC_POLYGON_MARKETCARD=https://opensea.io/assets/matic/[PH_ADDR]/[PH_ID]
NEXT_PUBLIC_POLYGON_COIN=MATIC
NEXT_PUBLIC_POLYGON_BUY=https://www.moonpay.com/buy/matic
NEXT_PUBLIC_POLYGON_LITTLE_TRAVELER_ADDRESS=0x37CAB9F09a2FfA8C8650DD3De3594e1Cf2F38A84

# ==============================================================================
# SOCIAL LINKS & GENERAL
# ==============================================================================
NEXT_PUBLIC_GEN_TWITTER=https://twitter.com/Web3InTravel
NEXT_PUBLIC_GEN_WEBSITE=https://web3intravel.com
NEXT_PUBLIC_GEN_DISCORD=https://discord.gg/yourdiscord
NEXT_PUBLIC_GEN_TRIPSCOMMUNITY=https://tripscommunity.com
NEXT_PUBLIC_GEN_GITHUB=https://github.com/jacmos3/Conference-NFT-Ticket
NEXT_PUBLIC_GEN_POLICY=https://web3intravel.com/privacy

# ==============================================================================
# FEATURE LINKS
# ==============================================================================
NEXT_PUBLIC_GEN_LNK_BONDING_CURVE=https://docs.web3intravel.com/bonding-curve
NEXT_PUBLIC_GEN_LNK_AIRDROP=https://docs.web3intravel.com/airdrop
NEXT_PUBLIC_GEN_LNK_HOW_TO_ACCESS=https://docs.web3intravel.com/access
NEXT_PUBLIC_GEN_LNK_SPONSOR_READ_MORE=https://docs.web3intravel.com/sponsorship
NEXT_PUBLIC_GEN_LNK_LEARN_MORE=https://docs.web3intravel.com
NEXT_PUBLIC_LNK_LITTLE_TRAVELER=https://opensea.io/collection/little-traveler

# ==============================================================================
# OPTIONAL: TESTNET CONFIGURATION (uncomment to use)
# ==============================================================================
# NEXT_PUBLIC_GOERLI_NAME=Goerli
# NEXT_PUBLIC_GOERLI_ID=5
# NEXT_PUBLIC_GOERLI_CONTRACT_ADDRESS=0xYourTestContractAddress
# NEXT_PUBLIC_GOERLI_MARKETPLACE=https://testnets.opensea.io/collection/...
# NEXT_PUBLIC_GOERLI_MARKETCARD=https://testnets.opensea.io/assets/goerli/[PH_ADDR]/[PH_ID]
# NEXT_PUBLIC_GOERLI_COIN=ETH
# NEXT_PUBLIC_GOERLI_BUY=https://goerlifaucet.com
# NEXT_PUBLIC_GOERLI_LITTLE_TRAVELER_ADDRESS=0x...

# ==============================================================================
# PRODUCTION
# ==============================================================================
NODE_ENV=production
